APP_ENV=production
APP_PORT=8080

# Bind API to localhost by default. Put Nginx/Caddy/Traefik in front for TLS.
API_HOST=127.0.0.1
API_HOST_PORT=8080

POSTGRES_USER=udharo
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=udharo_pro

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret

RESEND_API_KEY=re_replace_with_resend_api_key
EMAIL_FROM="Udharo Pro <no-reply@example.com>"
CORS_ALLOWED_ORIGINS=https://app.example.com
